# Client ID of your PayPal SANDBOX REST app
# (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=

# Secret of the same SANDBOX REST app. Never commit the real value.
PAYPAL_CLIENT_SECRET=

# Email of a sandbox PERSONAL account that receives test payouts
# (developer.paypal.com -> Testing Tools -> Sandbox Accounts)
PAYPAL_TEST_RECEIVER=

# Must stay SANDBOX. Scripts refuse to run against anything else.
PAYPAL_ENVIRONMENT=SANDBOX

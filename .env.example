# Client ID of your PayPal SANDBOX REST app
# (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=

# Secret of the same SANDBOX REST app. Never commit the real value.
PAYPAL_CLIENT_SECRET=

# Email of a sandbox PERSONAL account that receives test payouts
# (developer.paypal.com -> Testing Tools -> Sandbox Accounts)
PAYPAL_TEST_RECEIVER=

# Must stay SANDBOX. Scripts refuse to run against anything else.
PAYPAL_ENVIRONMENT=SANDBOX

# Database connection string. SQLite file for local dev; switches to Postgres when we host.
DATABASE_URL="file:./dev.db"

# Secret used to verify GitHub webhook signatures (set the same value in the GitHub webhook settings).
GITHUB_WEBHOOK_SECRET=

# GitHub personal access token used to read PRs, CI status and issues. Never commit a real one.
GITHUB_TOKEN=

# API key for the LLM provider used by the PR reviewer. Never commit a real one.
LLM_API_KEY=

# AG Studio license key. Browser-side by design (NEXT_PUBLIC_); use the trial key and never commit a real one.
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# Shared secret that protects the /api/demo/* routes.
DEMO_ADMIN_SECRET=

# Same SANDBOX client ID as PAYPAL_CLIENT_ID. Safe in the browser (used by PayPal's JS SDK to fund bounties).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
